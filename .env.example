# ============================================================
# MONGODB ATLAS CONNECTION
# ============================================================
MONGODB_URL=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# ============================================================
# JWT SECRET KEY (Thay đổi thành chuỗi ngẫu nhiên phức tạp)
# ============================================================
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-use-openssl-rand-hex-32

# ============================================================
# HUGGINGFACE TOKEN (Nếu có)
# ============================================================
HF_TOKEN=

# YouTube Data API v3 key (Google Cloud Console > APIs & Services > Credentials).
# Search keeps working when YouTube blocks a hosting IP. Free quota: 10,000 units/day, one search = 100.
YOUTUBE_API_KEY=

# Optional: cookies.txt text from a signed-in browser (a throwaway Google account), so yt-dlp can fetch audio.
# Set as a secret named YTDLP_COOKIES, or point YTDLP_COOKIES_FILE at a file.
YTDLP_COOKIES=
